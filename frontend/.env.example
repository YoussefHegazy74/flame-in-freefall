# FLAREX — frontend environment
#
# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit real secrets.
# This frontend is read-only and sends no credentials or cookies.

# FastAPI base path. The backend must allow this frontend origin through
# FLAME_CORS_ORIGINS (defaults include http://localhost:3000).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Public site URL, used only for documentation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
