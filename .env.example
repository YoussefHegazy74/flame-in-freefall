# Flame in Freefall — environment template
#
# Copy to .env for local development:
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials, tokens, presigned URLs,
# or private keys. The values below are placeholders. Blank optional provider
# values keep the assistant in deterministic mode.
#
# FLAME_* variables take precedence over the legacy aliases shown in the
# final section.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local
APP_NAME=Flame in Freefall
APP_VERSION=0.1.0-foundation
FLAME_LOG_LEVEL=INFO

# API
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_PATH=/api/v1
FLAME_CORS_ORIGINS=http://localhost:3000

# Frontend (public values only)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API operations
FLAME_CACHE_ENABLED=true
FLAME_CACHE_MAX_AGE=60
FLAME_CACHE_CONTROL=
FLAME_RATE_LIMIT_ENABLED=true
FLAME_RATE_LIMIT_REQUESTS=600
FLAME_RATE_LIMIT_WINDOW_SECONDS=60
FLAME_TRUST_PROXY=false
FLAME_MAX_REQUEST_BYTES=1048576
FLAME_METRICS_ENABLED=true
FLAME_READINESS_REQUIRE_FULL_DATASET=true
FLAME_READINESS_REQUIRE_ASSISTANT_INDEX=true
FLAME_QUERY_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Data paths (local development)
# Raw, interim, and processed data are gitignored.
# ---------------------------------------------------------------------------
REGISTRY_DIR=./data/registry
RAW_DATA_DIR=./data/raw
INTERIM_DATA_DIR=./data/interim
PROCESSED_DATA_DIR=./data/processed
FIXTURES_DIR=./data/fixtures

# Optional explicit overrides used by the API and registry loader.
# FLAME_REGISTRY_DIR=./data/registry
# FLAME_PROCESSED_DIR=./data/processed
# FLAME_REPORTS_DIR=./data/reports

# NASA PSI public API (no key required)
PSI_API_BASE=https://psi.nasa.gov/geode-py/ws
PSI_REQUEST_TIMEOUT_SECONDS=90
PSI_REQUEST_RETRIES=4

# ---------------------------------------------------------------------------
# Metadata database (Phase 3+)
# Use a local, non-production password in .env only.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://flame:change-me@localhost:5432/flame_in_freefall
POSTGRES_DB=flame_in_freefall
POSTGRES_USER=flame
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Object storage for raw and processed data (Phase 1+)
# MinIO is optional for local development; DuckDB can read Parquet directly.
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=flame-in-freefall
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_REGION=us-east-1
S3_USE_TLS=false

# ---------------------------------------------------------------------------
# Analytical store (Phase 2+)
# ---------------------------------------------------------------------------
DUCKDB_PATH=./data/processed/flame.duckdb

# ---------------------------------------------------------------------------
# Grounded research assistant (Phase 5)
# The assistant works with no LLM configured.
#
# Provider:
#   deterministic      — default; no network call (recommended)
#   openai_compatible  — only rephrases a validated deterministic draft
#
# An openai_compatible provider requires FLAME_LLM_BASE_URL,
# FLAME_LLM_MODEL, and FLAME_LLM_API_KEY. Invalid optional provider
# configuration degrades safely to deterministic mode.
# ---------------------------------------------------------------------------
FLAME_ASSISTANT_ENABLED=true
FLAME_LLM_PROVIDER=deterministic
FLAME_LLM_MODEL=
FLAME_LLM_API_KEY=
FLAME_LLM_BASE_URL=
FLAME_LLM_MAX_RETRIES=2
FLAME_LLM_RETRY_BACKOFF_SECONDS=0.5
# Optional USD pricing per million tokens for cost estimation.
FLAME_LLM_INPUT_COST_PER_MILLION=
FLAME_LLM_OUTPUT_COST_PER_MILLION=

# Retrieval index. The shipped index is deterministic lexical BM25 + hashed
# TF-IDF with source-aware ranking; no external embedding service is required.
# The embedding settings are validated but are not used by the current builder.
FLAME_RETRIEVAL_ENABLED=true
FLAME_EMBEDDING_PROVIDER=deterministic
FLAME_EMBEDDING_MODEL=tfidf-hash-v1

# Execution bounds
FLAME_ASSISTANT_MAX_TOOL_CALLS=6
FLAME_ASSISTANT_TIMEOUT_SECONDS=20
FLAME_ASSISTANT_MAX_CONTEXT_TURNS=4
FLAME_ASSISTANT_MAX_QUESTION_CHARS=1000

# ---------------------------------------------------------------------------
# Legacy assistant aliases (optional)
# Prefer the FLAME_* names above. These remain accepted for compatibility.
# ---------------------------------------------------------------------------
# ASSISTANT_ENABLED=false
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Observability (Phase 6+)
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=flame-in-freefall-api
SENTRY_DSN=
