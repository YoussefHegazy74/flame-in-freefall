# Flame in Freefall — environment template
#
# Copy to .env for local development:
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials, tokens, presigned URLs,
# or private keys. The values below are placeholders and are not used by the
# foundation milestone (metadata collector + documentation).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local
APP_NAME=Flame in Freefall
APP_VERSION=0.1.0-foundation
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_PATH=/api/v1
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Data paths (local development)
# Raw, interim, and processed data are gitignored.
# ---------------------------------------------------------------------------
REGISTRY_DIR=./data/registry
RAW_DATA_DIR=./data/raw
INTERIM_DATA_DIR=./data/interim
PROCESSED_DATA_DIR=./data/processed
FIXTURES_DIR=./data/fixtures

# NASA PSI public API (no key required)
PSI_API_BASE=https://psi.nasa.gov/geode-py/ws
PSI_REQUEST_TIMEOUT_SECONDS=90
PSI_REQUEST_RETRIES=4

# ---------------------------------------------------------------------------
# Metadata database (Phase 3+)
# Use a local, non-production password in .env only.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://flame:change-me@localhost:5432/flame_in_freefall
POSTGRES_DB=flame_in_freefall
POSTGRES_USER=flame
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Object storage for raw and processed data (Phase 1+)
# MinIO is optional for local development; DuckDB can read Parquet directly.
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=flame-in-freefall
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_REGION=us-east-1
S3_USE_TLS=false

# ---------------------------------------------------------------------------
# Analytical store (Phase 2+)
# ---------------------------------------------------------------------------
DUCKDB_PATH=./data/processed/flame.duckdb

# ---------------------------------------------------------------------------
# Optional grounded insight layer (Phase 5+)
# The core product must work with the assistant disabled.
# ---------------------------------------------------------------------------
ASSISTANT_ENABLED=false
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1200

# ---------------------------------------------------------------------------
# Observability (Phase 6+)
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=flame-in-freefall-api
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Rate limiting (Phase 3+)
# ---------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60
ASSISTANT_RATE_LIMIT_REQUESTS_PER_MINUTE=10
